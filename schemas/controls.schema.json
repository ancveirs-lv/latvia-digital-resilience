{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ancveirs-lv/latvia-digital-resilience/main/schemas/controls.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "controls"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "proposal_id",
          "control_type",
          "title_en",
          "title_lv",
          "requirement_en",
          "requirement_lv",
          "verification_en",
          "verification_lv"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "proposal_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "control_type": {
            "enum": [
              "governance",
              "evidence",
              "operational",
              "safety"
            ]
          },
          "title_en": {
            "type": "string",
            "minLength": 3
          },
          "title_lv": {
            "type": "string",
            "minLength": 3
          },
          "requirement_en": {
            "type": "string",
            "minLength": 15
          },
          "requirement_lv": {
            "type": "string",
            "minLength": 15
          },
          "verification_en": {
            "type": "string",
            "minLength": 10
          },
          "verification_lv": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  }
}

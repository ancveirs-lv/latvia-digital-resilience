{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ancveirs-lv/latvia-digital-resilience/main/schemas/pilots.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "pilots"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "pilots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "proposal_id",
          "control_ids",
          "scope_en",
          "scope_lv",
          "prerequisites_en",
          "prerequisites_lv",
          "acceptance_criteria"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "proposal_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "control_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          },
          "scope_en": {
            "type": "string",
            "minLength": 20
          },
          "scope_lv": {
            "type": "string",
            "minLength": 20
          },
          "prerequisites_en": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 5
            }
          },
          "prerequisites_lv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 5
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "statement_en",
                "statement_lv",
                "evidence_required"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$"
                },
                "statement_en": {
                  "type": "string",
                  "minLength": 20
                },
                "statement_lv": {
                  "type": "string",
                  "minLength": 20
                },
                "evidence_required": {
                  "type": "string",
                  "minLength": 5
                }
              }
            }
          }
        }
      }
    }
  }
}

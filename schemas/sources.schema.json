{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ancveirs-lv/latvia-digital-resilience/main/schemas/sources.schema.json",
  "type": "object",
  "required": ["schema_version", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "publisher", "url", "source_type", "jurisdiction", "supports", "retrieved"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "title": {"type": "string", "minLength": 3},
          "publisher": {"type": "string", "minLength": 2},
          "url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "source_type": {"type": "string", "minLength": 3},
          "jurisdiction": {"type": "string", "minLength": 3},
          "supports": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
          },
          "retrieved": {"type": "string", "format": "date"}
        }
      }
    }
  }
}
